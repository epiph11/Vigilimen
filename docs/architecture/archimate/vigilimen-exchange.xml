<element identifier="id-m01" xsi:type="Driver"><name xml:lang="en">s8C three-month independence</name><documentation xml:lang="en">Enhanced CIRMP</documentation></element>
<element identifier="id-m02" xsi:type="Driver"><name xml:lang="en">WHS duty</name><documentation xml:lang="en">Safety-critical OT is a WHS matter (ADR-006)</documentation></element>
<element identifier="id-m03" xsi:type="Goal"><name xml:lang="en">Local autonomy</name><documentation xml:lang="en">Site operates without external systems</documentation></element>
<element identifier="id-m04" xsi:type="Goal"><name xml:lang="en">Safe operation</name><documentation xml:lang="en">Protective function always works</documentation></element>
<element identifier="id-m05" xsi:type="Principle"><name xml:lang="en">Segmentation is the authentication</name><documentation xml:lang="en">protocol-register.md</documentation></element>
<element identifier="id-m06" xsi:type="Requirement"><name xml:lang="en">Local chain has no outbound dependency</name><documentation xml:lang="en">Collector and historian never depend on edge, broker or WAN (ADR-020)</documentation></element>
<element identifier="id-m07" xsi:type="Requirement"><name xml:lang="en">SIS stays unlinked</name><documentation xml:lang="en">ADR-014, FF-22</documentation></element>
<element identifier="id-m08" xsi:type="Constraint"><name xml:lang="en">No security control inside a protective function</name><documentation xml:lang="en">ADR-011 (TRITON lesson)</documentation></element>
