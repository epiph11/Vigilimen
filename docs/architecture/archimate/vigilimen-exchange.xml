<element identifier="id-t02" xsi:type="Device"><name xml:lang="en">SIS-CONV-001</name><documentation xml:lang="en">OpenPLC v3: safety function, no link (ADR-014)</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">built</value></property></properties></element>
<element identifier="id-t03" xsi:type="Node"><name xml:lang="en">Docker host</name><documentation xml:lang="en">Single host running 6 containers</documentation></element>
<element identifier="id-t04" xsi:type="Artifact"><name xml:lang="en">conveyor.st</name><documentation xml:lang="en">Control program</documentation></element>
<element identifier="id-t05" xsi:type="Artifact"><name xml:lang="en">safety.st</name><documentation xml:lang="en">Safety program</documentation></element>
<element identifier="id-t06" xsi:type="CommunicationNetwork"><name xml:lang="en">net_control</name><documentation xml:lang="en">internal</documentation></element>
<element identifier="id-t07" xsi:type="CommunicationNetwork"><name xml:lang="en">net_supervisory</name><documentation xml:lang="en">bridge today</documentation></element>
<element identifier="id-t08" xsi:type="CommunicationNetwork"><name xml:lang="en">net_safety</name><documentation xml:lang="en">internal, single member</documentation></element>
