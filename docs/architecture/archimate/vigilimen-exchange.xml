<element identifier="id-e03" xsi:type="BusinessProcess"><name xml:lang="en">Operate the conveyor</name><documentation xml:lang="en">Start, stop, acknowledge alarms</documentation></element>
<element identifier="id-e04" xsi:type="BusinessService"><name xml:lang="en">Safe conveyor operation</name><documentation xml:lang="en">What the plant owner gets</documentation></element>
<element identifier="id-a01" xsi:type="ApplicationComponent"><name xml:lang="en">SCADA (FUXA)</name><documentation xml:lang="en">MIT licence, ADR-012. OPC UA client</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">built</value></property></properties></element>
<element identifier="id-a02" xsi:type="ApplicationComponent"><name xml:lang="en">gateway</name><documentation xml:lang="en">Physics + OPC UA server + Modbus client + modelled contactor</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">built</value></property></properties></element>
<element identifier="id-a03" xsi:type="ApplicationComponent"><name xml:lang="en">collector</name><documentation xml:lang="en">Reads OPC UA at 1 Hz, evaluates alarms, writes the historian</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">built</value></property></properties></element>
<element identifier="id-a04" xsi:type="ApplicationComponent"><name xml:lang="en">historian</name><documentation xml:lang="en">TimescaleDB: local memory (s8C)</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">built</value></property></properties></element>
<element identifier="id-a05" xsi:type="ApplicationComponent"><name xml:lang="en">edge</name><documentation xml:lang="en">PLANNED S5 (ADR-020): outbound publisher, OPC UA client to MQTT, never writes</documentation><properties><property propertyDefinitionRef="propid-1"><value xml:lang="en">planned</value></property><property propertyDefinitionRef="propid-2"><value xml:lang="en">S5</value></property></properties></element>
<element identifier="id-a06" xsi:type="ApplicationInterface"><name xml:lang="en">OPC UA (gateway)</name><documentation xml:lang="en">Port 4840, accounts historian/engineer (ADR-017)</documentation></element>
<element identifier="id-d01" xsi:type="DataObject"><name xml:lang="en">Alarm history</name><documentation xml:lang="en">alarm_event append-only + alarm_state (ADR-019)</documentation></element>
