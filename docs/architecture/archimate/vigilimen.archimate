<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Vigilimen base model" id="id-vigilimen" version="5.0.0">
  <folder name="Strategy" id="id-7448b9e3754d40baaacd121e491f9f18" type="strategy"/>
  <folder name="Business" id="id-221cdc4e915849278ec93722abe2c153" type="business">
    <element xsi:type="archimate:BusinessActor" name="Operator" id="id-e01">
      <documentation>Runs the conveyor from the SCADA</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Vendor engineer" id="id-e02">
      <documentation>Remote vendor support (S5 planned, via jump host)</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Operate the conveyor" id="id-e03">
      <documentation>Start, stop, acknowledge alarms</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Safe conveyor operation" id="id-e04">
      <documentation>What the plant owner gets</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-9cb13198d7bc41d99cd69d9402aecbb1" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="SCADA (FUXA)" id="id-a01">
      <documentation>MIT licence, ADR-012. OPC UA client</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="gateway" id="id-a02">
      <documentation>Physics + OPC UA server + Modbus client + modelled contactor</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="collector" id="id-a03">
      <documentation>Reads OPC UA at 1 Hz, evaluates alarms, writes the historian</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="historian" id="id-a04">
      <documentation>TimescaleDB: local memory (s8C)</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="edge" id="id-a05">
      <documentation>PLANNED S5 (ADR-020): outbound publisher, OPC UA client to MQTT, never writes</documentation>
      <property key="status" value="planned"/>
      <property key="sprint" value="S5"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="OPC UA (gateway)" id="id-a06">
      <documentation>Port 4840, accounts historian/engineer (ADR-017)</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Alarm history" id="id-d01">
      <documentation>alarm_event append-only + alarm_state (ADR-019)</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-a0e56b6057ec4801bc35765d568fa11d" type="technology">
    <element xsi:type="archimate:Device" name="PLC-CONV-001" id="id-t01">
      <documentation>OpenPLC v3 (EOL, ADR-015): sequence + machine protection</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:Device" name="SIS-CONV-001" id="id-t02">
      <documentation>OpenPLC v3: safety function, no link (ADR-014)</documentation>
      <property key="status" value="built"/>
    </element>
    <element xsi:type="archimate:Node" name="Docker host" id="id-t03">
      <documentation>Single host running 6 containers</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="conveyor.st" id="id-t04">
      <documentation>Control program</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="safety.st" id="id-t05">
      <documentation>Safety program</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="net_control" id="id-t06">
      <documentation>internal</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="net_supervisory" id="id-t07">
      <documentation>bridge today</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="net_safety" id="id-t08">
      <documentation>internal, single member</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Modbus TCP" id="id-t09">
      <documentation>No authentication: segmentation is the authentication</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="OPC UA" id="id-t10">
      <documentation>Certificates and user tokens</documentation>
    </element>
    <element xsi:type="archimate:Equipment" name="Motor contactor" id="id-t11">
      <documentation>Series AND of control run request and safety coil (ADR-011). Modelled in the gateway</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-8a9e1144239e4d3f8dabea523f0b5ca1" type="motivation">
    <element xsi:type="archimate:Driver" name="s8C three-month independence" id="id-m01">
      <documentation>Enhanced CIRMP</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="WHS duty" id="id-m02">
      <documentation>Safety-critical OT is a WHS matter (ADR-006)</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Local autonomy" id="id-m03">
      <documentation>Site operates without external systems</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Safe operation" id="id-m04">
      <documentation>Protective function always works</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Segmentation is the authentication" id="id-m05">
      <documentation>protocol-register.md</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Local chain has no outbound dependency" id="id-m06">
      <documentation>Collector and historian never depend on edge, broker or WAN (ADR-020)</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="SIS stays unlinked" id="id-m07">
      <documentation>ADR-014, FF-22</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="No security control inside a protective function" id="id-m08">
      <documentation>ADR-011 (TRITON lesson)</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-d6bb900ef9854a4184c3f70b60ad7540" type="implementation_migration"/>
